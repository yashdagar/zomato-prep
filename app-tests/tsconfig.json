{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "baseUrl": "..",
    "paths": { "@app/*": ["app/lib/*"] }
  },
  "include": ["lib/**/*.ts", "mocks/**/*.ts", "../app/lib/**/*.ts"]
}
